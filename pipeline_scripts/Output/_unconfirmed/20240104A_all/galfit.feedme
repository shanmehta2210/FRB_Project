# IMAGE and GALFIT CONTROL PARAMETERS
A) host_cutout.fits  # Input data image (FITS file)
B) out.fits  # Output data image block
C) host_sigma.fits  # Sigma image name (none = let GALFIT auto-generate)
D) proto_image.fits  # Input PSF file
E) 1  # PSF fine sampling factor
F) host_mask.fits  # Bad pixel mask
G) constraints.txt  # File with parameter constraints
H) 1 57 1 56  # Image region to fit (1-based full image)
I) 81 80  # Size of convolution box
J) 32.1717  # Photometric zeropoint
K) 0.262 0.262  # Plate scale [arcsec/pixel]
O) regular  # Display type
P) 0  # Choose: 0=optimize

# INITIAL FITTING PARAMETERS
# Component number: 1
 0) sersic  # Component type
 1) 29.4059 28.3868 1 1  # position x y
 3) 17.9677 1  # Integrated magnitude
 4) 2.8158 1  # effective radius (pix)
 5) 1.0000 1  # sersic index
 6) 0.0000 0  # ----
 7) 0.0000 0  # ----
 8) 0.0000 0  # ----
 9) 0.9811 1  # Axis ratio (b/a)
10) -37.1729 1  # Position angle
 Z) 0  # Skip this model

# Component number: 2
 0) sky  # component type
 1) -4.294505 1  # Sky background (SExtractor BACKGROUND, ADU)
 2) 0.0000 0  # dsky/dx
 3) 0.0000 0  # dsky/dy
 Z) 0  # Skip this model

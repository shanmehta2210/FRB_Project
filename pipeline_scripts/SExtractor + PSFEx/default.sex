# Default configuration file for SExtractor
CATALOG_NAME     image.cat
CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  default.param

DETECT_TYPE      CCD
DETECT_MINAREA   5
THRESH_TYPE      RELATIVE
DETECT_THRESH    10
ANALYSIS_THRESH  10

FILTER           Y
FILTER_NAME      default.conv

DEBLEND_NTHRESH  32
DEBLEND_MINCONT  0.005

CLEAN            Y
CLEAN_PARAM      1.0

WEIGHT_TYPE      NONE
WEIGHT_IMAGE     NONE

PHOT_APERTURES   4.0, 5.0, 6.0, 7.0, 8.0, 9.0, 10.0, 11.0, 12.0, 13.0, 15.0, 20.0, 25.0, 30.0, 40.0
PHOT_FLUXFRAC    0.5
PHOT_AUTOPARAMS  1.0,2.0
PHOT_PETROPARAMS 1.0,2.0

SATUR_KEY        SATURATE
SATUR_LEVEL      90000

MAG_ZEROPOINT    0.0
MAG_GAMMA        4.0
GAIN             1.6
PIXEL_SCALE      0.0

SEEING_FWHM      2.0
STARNNW_NAME     default.nnw

BACK_SIZE        1024
BACK_FILTERSIZE  3

BACK_TYPE        AUTO
BACKPHOTO_TYPE   LOCAL

CHECKIMAGE_TYPE  SEGMENTATION
CHECKIMAGE_NAME  segmentation_map.fits

NTHREADS         1
MEMORY_OBJSTACK  10000
MEMORY_PIXSTACK  5000000
MEMORY_BUFSIZE   1024

VERBOSE_TYPE     NORMAL
WRITE_XML        N

===============================================================================
# IMAGE and GALFIT CONTROL PARAMETERS
A) host_cutout.fits  # Input data image (FITS file)
B) out.fits  # Output data image block
C) host_sigma.fits  # Sigma image name (none = let GALFIT auto-generate)
D) proto_image.fits  # Input PSF file
E) 1  # PSF fine sampling factor
F) host_mask.fits  # Bad pixel mask
G) constraints.txt  # File with parameter constraints
H) 1 45 1 45  # Image region to fit (1-based full image)
I) 69 69  # Size of convolution box
J) 21.5643  # Photometric zeropoint
K) 0.262 0.262  # Plate scale [arcsec/pixel]
O) regular  # Display type
P) 0  # Choose: 0=optimize

# INITIAL FITTING PARAMETERS
# Component number: 1
 0) sersic  # Component type
 1) 23.4041 21.6719 1 1  # position x y
 3) 18.2798 1  # Integrated magnitude
 4) 100.0000 1  # effective radius (pix)
 5) 3.7587 1  # sersic index
 6) 0.0000 0  # ----
 7) 0.0000 0  # ----
 8) 0.0000 0  # ----
 9) 0.7599 1  # Axis ratio (b/a)
10) -87.0985 1  # Position angle
 Z) 0  # Skip this model

# Component number: 2
 0) sky  # component type
 1) -0.00012933 0  # Sky background (SExtractor BACKGROUND, ADU)
 2) 0.0000 0  # dsky/dx
 3) 0.0000 0  # dsky/dy
 Z) 0  # Skip this model

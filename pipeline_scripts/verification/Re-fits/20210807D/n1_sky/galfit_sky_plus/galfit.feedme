# IMAGE and GALFIT CONTROL PARAMETERS
A) host_cutout.fits  # Input data image (FITS file)
B) out.fits  # Output data image block
C) host_sigma.fits  # Sigma image name (none = let GALFIT auto-generate)
D) proto_image.fits  # Input PSF file
E) 1  # PSF fine sampling factor
F) host_mask.fits  # Bad pixel mask
G) constraints.txt  # File with parameter constraints
H) 1 93 1 101  # Image region to fit (1-based full image)
I) 117 125  # Size of convolution box
J) 32.6722  # Photometric zeropoint
K) 0.25 0.25  # Plate scale [arcsec/pixel]
O) regular  # Display type
P) 0  # Choose: 0=optimize

# INITIAL FITTING PARAMETERS
# Component number: 1
 0) sersic  # Component type
 1) 46.5550 59.1760 1 1  # position x y
 3) 17.4369 1  # Integrated magnitude
 4) 16.8457 1  # effective radius (pix)
 5) 1.0000 0  # sersic index
 6) 0.0000 0  # ----
 7) 0.0000 0  # ----
 8) 0.0000 0  # ----
 9) 0.7191 1  # Axis ratio (b/a)
10) 89.5671 1  # Position angle
 Z) 0  # Skip this model

# Component number: 2
 0) sky  # component type
 1) -12.59671174 0  # Sky background (SExtractor BACKGROUND, ADU)
 2) 0.0000 0  # dsky/dx
 3) 0.0000 0  # dsky/dy
 Z) 0  # Skip this model

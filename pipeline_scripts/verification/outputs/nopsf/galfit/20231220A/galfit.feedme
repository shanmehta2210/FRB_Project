===============================================================================
# IMAGE and GALFIT CONTROL PARAMETERS
A) host_cutout.fits  # Input data image (FITS file)
B) out.fits  # Output data image block
C) host_sigma.fits  # Sigma image name (none = let GALFIT auto-generate)
D) none  # Input PSF file (no-PSF control)
E) 1  # PSF fine sampling factor
F) host_mask.fits  # Bad pixel mask
G) constraints.txt  # File with parameter constraints
H) 1 55 1 58  # Image region to fit (1-based full image)
I) 79 82  # Size of convolution box
J) 22.5138  # Photometric zeropoint
K) 0.262 0.262  # Plate scale [arcsec/pixel]
O) regular  # Display type
P) 0  # Choose: 0=optimize

# INITIAL FITTING PARAMETERS
# Component number: 1
 0) sersic  # Component type
 1) 27.6981 30.0230 1 1  # position x y
 3) 20.0947 1  # Integrated magnitude
 4) 3.8487 1  # effective radius (pix)
 5) 1.0000 1  # sersic index
 6) 0.0000 0  # ----
 7) 0.0000 0  # ----
 8) 0.0000 0  # ----
 9) 0.6979 1  # Axis ratio (b/a)
10) -28.6611 1  # Position angle
 Z) 0  # Skip this model

# Component number: 2
 0) sky  # component type
 1) 0.000413 1  # Sky background (SExtractor BACKGROUND, ADU)
 2) 0.0000 0  # dsky/dx
 3) 0.0000 0  # dsky/dy
 Z) 0  # Skip this model
================================================================================

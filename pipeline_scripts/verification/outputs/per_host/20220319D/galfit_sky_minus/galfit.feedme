# IMAGE and GALFIT CONTROL PARAMETERS
A) host_cutout.fits  # Input data image (FITS file)
B) out.fits  # Output data image block
C) host_sigma.fits  # Sigma image name (none = let GALFIT auto-generate)
D) proto_image.fits  # Input PSF file
E) 1  # PSF fine sampling factor
F) host_mask.fits  # Bad pixel mask
G) constraints.txt  # File with parameter constraints
H) 1 154 1 123  # Image region to fit (1-based full image)
I) 178 147  # Size of convolution box
J) 32.1018  # Photometric zeropoint
K) 0.25 0.25  # Plate scale [arcsec/pixel]
O) regular  # Display type
P) 0  # Choose: 0=optimize

# INITIAL FITTING PARAMETERS
# Component number: 1
 0) sersic  # Component type
 1) 74.7642 60.5033 1 1  # position x y
 3) 16.0819 1  # Integrated magnitude
 4) 26.6496 1  # effective radius (pix)
 5) 6.0000 1  # sersic index
 6) 0.0000 0  # ----
 7) 0.0000 0  # ----
 8) 0.0000 0  # ----
 9) 0.8012 1  # Axis ratio (b/a)
10) 60.5809 1  # Position angle
 Z) 0  # Skip this model

# Component number: 2
 0) sky  # component type
 1) 152.23073494 0  # Sky background (SExtractor BACKGROUND, ADU)
 2) 0.0000 0  # dsky/dx
 3) 0.0000 0  # dsky/dy
 Z) 0  # Skip this model

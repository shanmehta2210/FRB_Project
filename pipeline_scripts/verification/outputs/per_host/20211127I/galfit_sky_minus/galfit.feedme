# IMAGE and GALFIT CONTROL PARAMETERS
A) host_cutout.fits  # Input data image (FITS file)
B) out.fits  # Output data image block
C) host_sigma.fits  # Sigma image name (none = let GALFIT auto-generate)
D) proto_image.fits  # Input PSF file
E) 1  # PSF fine sampling factor
F) host_mask.fits  # Bad pixel mask
G) constraints.txt  # File with parameter constraints
H) 1 153 1 295  # Image region to fit (1-based full image)
I) 177 319  # Size of convolution box
J) 32.5884  # Photometric zeropoint
K) 0.25 0.25  # Plate scale [arcsec/pixel]
O) regular  # Display type
P) 0  # Choose: 0=optimize

# INITIAL FITTING PARAMETERS
# Component number: 1
 0) sersic  # Component type
 1) 83.8300 81.6988 1 1  # position x y
 3) 14.2521 1  # Integrated magnitude
 4) 100.0000 1  # effective radius (pix)
 5) 3.1420 1  # sersic index
 6) 0.0000 0  # ----
 7) 0.0000 0  # ----
 8) 0.0000 0  # ----
 9) 0.9682 1  # Axis ratio (b/a)
10) -30.9400 1  # Position angle
 Z) 0  # Skip this model

# Component number: 2
 0) sky  # component type
 1) -84.69753134 0  # Sky background (SExtractor BACKGROUND, ADU)
 2) 0.0000 0  # dsky/dx
 3) 0.0000 0  # dsky/dy
 Z) 0  # Skip this model

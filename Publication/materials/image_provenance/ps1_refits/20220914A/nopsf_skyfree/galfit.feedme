===============================================================================
# IMAGE and GALFIT CONTROL PARAMETERS
A) host_cutout.fits  # Input data image (FITS file)
B) out.fits  # Output data image block
C) host_sigma.fits  # Sigma image name (none = let GALFIT auto-generate)
D) none  # no PSF convolution (Bhardwaj-like)
E) 1  # PSF fine sampling factor
F) host_mask.fits  # Bad pixel mask
G) constraints.txt  # File with parameter constraints
H) 1 54 1 51  # Image region to fit (1-based full image)
I) 78 75  # Size of convolution box
J) 25.0000  # Photometric zeropoint
K) 0.262 0.262  # Plate scale [arcsec/pixel]
O) regular  # Display type
P) 0  # Choose: 0=optimize

# INITIAL FITTING PARAMETERS

# Component number: 1
 0) sersic  # Component type
 1) 27.0110 25.9755 1 1  # position x y
 3) 12.4809 1  # Integrated magnitude
 4) 3.0186 1  # effective radius (pix)
 5) 1.0000 1  # sersic index
 6) 0.0000 0  # ----
 7) 0.0000 0  # ----
 8) 0.0000 0  # ----
 9) 0.7531 1  # Axis ratio (b/a)
10) -65.6288 1  # Position angle
 Z) 0  # Skip this model

# Component number: 2
 0) sky  # component type
 1) 24.501730 1  # Sky background (SExtractor BACKGROUND, ADU)
 2) 0.0000 0  # dsky/dx
 3) 0.0000 0  # dsky/dy
 Z) 0  # Skip this model

================================================================================
